# ===== 模型配置（换模型只改这里，不用动代码；按顺序降级）=====
MODEL_NAME=qwen3.8-flash
MODEL_FALLBACKS=qwen3.7-plus,qwen3.7-flash,qwen3.7-max,qwen3.6-plus,qwen3.6-flash,qwen3.5-flash,qwen3.5-plus

# ===== 上下文治理 =====
# 历史估算超过这个 token 数就自动做摘要
CONTEXT_MAX_TOKENS=12000
# 摘要后保留最近多少条消息
CONTEXT_KEEP_MESSAGES=8

# ===== 数据库 =====
# 本地开发用 127.0.0.1；部署到服务器建议只走内网地址，不要对公网开放 5432
POSTGRES_URI=postgresql://user:password@127.0.0.1:5432/dbname?sslmode=disable

# ===== 通义千问（OpenAI 兼容协议）=====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 阿里云 OSS（图片直传；建议用只授权单桶的 RAM 子账号）=====
OSS_ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OSS_BUCKET=your-bucket-name
# 可选，默认 oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ===== LangSmith 链路追踪（可选）=====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=chief-agent

# ===== 服务开关 =====
# false = 关闭注册，只有已有账号能登录
REGISTRATION_ENABLED=false
# 是否开放 /docs /redoc /openapi.json（本地调试可设 true）
DOCS_ENABLED=false

# ===== 监听地址（默认 127.0.0.1:8001）=====
HOST=127.0.0.1
PORT=8001

# ===== 每用户每周配额与限流 =====
# 新用户的默认每周 token 额度（0 = 不限）
DEFAULT_WEEKLY_TOKEN_QUOTA=1000000
# 每个用户每分钟最多发起多少次对话（0 = 不限）
RATE_LIMIT_PER_MINUTE=6
# 额度按哪个时区的自然周重置
QUOTA_TIMEZONE=Asia/Shanghai

# ===== 管理后台 =====
# 保证是管理员的账号（逗号分隔）；启动时补齐，只提升不降级
ADMIN_USERNAMES=your-admin-username
